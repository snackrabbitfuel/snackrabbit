  /* La única forma de sacar texto. Si falta una clave se devuelve la clave
     misma: en pantalla canta, que es justo lo que quieres en desarrollo, en
     vez de un hueco silencioso. */
  const T = (k) => I18N[LANG][k] ?? I18N.en[k] ?? k;

  const PK = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY;
  const $ = (s, c = document) => c.querySelector(s);
