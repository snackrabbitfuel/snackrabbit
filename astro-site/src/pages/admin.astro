      { id: "SR-1043", quien: "Jordan M. · Boise, ID",    items: [["RABBIT FUEL ×4", 1, 16], ["THE ZOOMIES", 1, 29]],  estado: "retraso",   fecha: "29 JUL 10:15" },
      { id: "SR-1042", quien: "Liam S. · Nashville, TN",  items: [["THE LOOKOUT · NEGRO", 1, 35]],                     estado: "entregado", fecha: "2 AGO 09:54" },
      { id: "SR-1041", quien: "Mía C. · Phoenix, AZ",     items: [["RABBIT FUEL ×12", 1, 42]],                         estado: "entregado", fecha: "1 AGO 17:31" },
      { id: "SR-1040", quien: "Lucas B. · Seattle, WA",   items: [["RABBIT FUEL ×4", 3, 16]],                          estado: "entregado", fecha: "1 AGO 12:19" },
    ],
    series: {
      7:  [412, 388, 641, 502, 720, 655, 487],
      30: [220, 310, 290, 405, 380, 340, 412, 505, 470, 390, 520, 610, 480, 530, 590, 640, 410, 505, 635, 720, 680, 590, 612, 640, 700, 655, 610, 590, 640, 487],
      90: Array.from({ length: 90 }, (_, i) => 260 + Math.round(180 * Math.sin(i / 8) + i * 3.2 + (i * 37 % 90))),
    },
    actividad: [
      { t: "09:41", que: "<b>SR-1049</b> pagado — $71.00", hito: true },
      { t: "09:12", que: "Fundador nuevo: <b>@mochi.dev</b> (67/100)", hito: true },
      { t: "08:12", que: "<b>SR-1048</b> pagado — $35.00" },
