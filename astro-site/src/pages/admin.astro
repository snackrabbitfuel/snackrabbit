  /* Los estados y las columnas se resuelven al pintar, no se guardan: así el
     cambio de idioma solo tiene que volver a pintar. */
  const COLS = () => [["pagado", T("col.topack")], ["prepara", T("col.packing")], ["empacado", T("col.packed")],
                      ["enviado", T("col.carrier")], ["retraso", T("col.delayed")]];
