      { t: "AYER",  que: "<b>SR-1045</b> y <b>SR-1044</b> recogidos por USPS" },
    ],
    envios: [
      ["SR-1045", "USPS Ground Advantage", "9400 1112 0345", "enviado", "7 AGO"],
      ["SR-1044", "USPS Priority Cubic",   "9405 5036 9930", "enviado", "6 AGO"],
      ["SR-1043", "USPS Ground Advantage", "9400 1108 2214", "retraso", "—"],
      ["SR-1042", "UPS Ground",            "1Z 999 AA1 01",  "entregado", "2 AGO"],
    ],
    fundadores: ["@mochi.dev", "@la.vecina.astral", "@pixelhops", "@caro_zzz", "@bunnywatcher", "@el.tomas", "@dailyfuel", "@renata.gif"],
    clientes: [
      ["Emma T. · Chicago, IL", 6, "$318.40", "3 AGO", "IV · THE DIGGER"],
      ["Lucas B. · Seattle, WA", 5, "$241.00", "1 AGO", "III · THE SCOUT"],
      ["Ava R. · Austin, TX", 4, "$226.50", "HOY", "III · THE SCOUT"],
      ["Sofía L. · Queens, NY", 3, "$188.20", "4 AGO", "II · THE HOPPER"],
    ],
    productos: [
      { n: "RABBIT FUEL", v: "PACK ×4 · $16 — PACK ×12 · $42", stock: 18,  max: 200, ventas: 82 },
      { n: "THE LOOKOUT", v: "BLANCO · NEGRO — $35",           stock: 64,  max: 120, ventas: 34 },
      { n: "THE ZOOMIES", v: "NEGRO — $29",                    stock: 91,  max: 150, ventas: 27 },
    ],
    porEstado: [["TEXAS", 21], ["CALIFORNIA", 18], ["NUEVA YORK", 14], ["FLORIDA", 11], ["ILLINOIS", 8]],
    fuentes: [["TIKTOK / IG ORGÁNICO", 64], ["DIRECTO", 22], ["BÚSQUEDA", 9], ["LISTA DE CORREO", 5]],
    hilos: [
      { de: "ava@…com", tema: "¿Cuándo llega la carta de agosto?", msgs: [["ellos", "¡Hola! Pedí la ×12 y quería saber cuándo sale la carta del mes."], ["yo", "¡Hola Ava! Las cajas del club salen juntas la primera semana del mes — la tuya sale el lunes con la carta dentro. 🐰"]] },
      { de: "jordan@…com", tema: "Mi pedido no se mueve", msgs: [["ellos", "SR-1043 lleva días sin actualizar el tracking…"], ["yo", "Tienes razón y ya está en la cola de reclamo con USPS. Si el sábado no se mueve, te reenviamos sin coste."]] },
      { de: "sam@…com", tema: "¿Talla de THE LOOKOUT?", msgs: [["ellos", "¿La M queda oversize?"]] },
    ],
  };
  const COLS = [["pagado", "PENDIENTE"], ["prepara", "PREPARANDO"], ["empacado", "EMPACADO"], ["enviado", "TRANSPORTISTA"], ["retraso", "RETRASADO"]];
  const TXT = { pagado: "PAGADO", prepara: "PREPARANDO", empacado: "EMPACADO", enviado: "ENVIADO", entregado: "ENTREGADO", retraso: "RETRASADO" };
  const money = n => "$" + n.toFixed(2);
  const total = p => p.items.reduce((s, [, c, pr]) => s + c * pr, 0);

  /* ══════════ utilidades de vida ══════════ */
  function contar(el, fin, dur = 900) {
    if (reducido) { el.textContent = fin.toLocaleString("en-US"); return; }
    const t0 = performance.now();
    const paso = t => {
      const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      el.textContent = Math.round(fin * e).toLocaleString("en-US");
      if (k < 1) requestAnimationFrame(paso);
      else { el.classList.add("late-pop"); setTimeout(() => el.classList.remove("late-pop"), 600); }
    };
    requestAnimationFrame(paso);
  }
  function toast(msg) {
    const t = document.createElement("div");
    t.className = "toast";
    t.innerHTML = '<svg><use href="#bunny"/></svg><span></span>';
    t.lastElementChild.textContent = msg;
    $("#toasts").appendChild(t);
    setTimeout(() => { t.classList.add("fuera"); setTimeout(() => t.remove(), 400); }, 3400);
  }
  document.addEventListener("click", e => {
    const b = e.target.closest("[data-toast]");
    if (b) toast(b.dataset.toast);
  });

  /* revelado escalonado al entrar cada sección */
  function revelar(sec) {
    $$(".rv", sec).forEach(el => el.classList.remove("in"));
    requestAnimationFrame(() => requestAnimationFrame(() =>
      $$(".rv", sec).forEach(el => el.classList.add("in"))));
    $$("[data-cuenta]", sec).forEach(el => contar(el, +el.dataset.cuenta));
    $$(".barra i[data-w]", sec).forEach(i => { i.style.width = "0"; requestAnimationFrame(() => requestAnimationFrame(() => { i.style.width = i.dataset.w; })); });
    $$(".linea-t li", sec).forEach(li => { li.style.animation = "none"; void li.offsetWidth; li.style.animation = ""; });
  }

  /* ══════════ pintado con datos DEMO ══════════ */
  function filaPedido(p, corta = false) {
    const tr = document.createElement("tr");
    tr.dataset.ped = p.id;
    const celdas = corta
      ? [`<b>${p.id}</b>`, p.quien.split(" · ")[0], `<b>${money(total(p))}</b>`, `<span class="est ${p.estado}">${TXT[p.estado]}</span>`]
      : [`<b>${p.id}</b>`, p.quien, p.items.map(i => i[0]).join(" + "), `<b>${money(total(p))}</b>`, `<span class="est ${p.estado}">${TXT[p.estado]}</span>`, p.fecha];
    tr.innerHTML = celdas.map(c => `<td>${c}</td>`).join("");
    tr.addEventListener("click", () => abrirPedido(p));
    return tr;
  }
  function pintarTablas(filtro = "", busca = "") {
    const tb1 = $("#tablaResumen tbody"), tb2 = $("#tablaPedidos tbody");
    tb1.textContent = ""; tb2.textContent = "";
    DEMO.pedidos.slice(0, 5).forEach(p => tb1.appendChild(filaPedido(p, true)));
    DEMO.pedidos
      .filter(p => !filtro || p.estado === filtro)
      .filter(p => !busca || (p.id + p.quien).toLowerCase().includes(busca))
      .forEach(p => tb2.appendChild(filaPedido(p)));
  }
  function pintarActividad() {
    $("#actividad").innerHTML = DEMO.actividad.map((a, i) =>
      `<li style="--i:${i}" class="${a.hito ? "hito" : ""}"><span class="lt-punto"></span><div><p>${a.que}</p><time>${a.t}</time></div></li>`).join("");
  }
  function pintarStock() {
    $("#stockBajo").innerHTML = DEMO.productos.map(p => {
      const pct = Math.round(p.stock / p.max * 100);
      const clase = pct < 15 ? "baja" : pct < 45 ? "" : "ok";
      return `<div><div class="tp-lab"><span>${p.n}</span><b>${p.stock} uds</b></div><div class="barra ${clase}"><i data-w="${pct}%"></i></div></div>`;
    }).join("");
    $("#topProd").innerHTML = DEMO.productos.map(p => {
      const pct = Math.round(p.ventas / DEMO.productos[0].ventas * 100);
      return `<div><div class="tp-lab"><span>${p.n}</span><b>${p.ventas}</b></div><div class="barra"><i data-w="${pct}%"></i></div></div>`;
    }).join("");
  }
  function pintarFulMini() {
    const cuenta = Object.fromEntries(COLS.map(([k]) => [k, 0]));
    DEMO.pedidos.forEach(p => { if (p.estado in cuenta) cuenta[p.estado]++; });
    $("#fulMini").innerHTML = COLS.map(([k, nom]) =>
      `<div style="border:2px solid var(--line-dark); padding:12px; text-align:center">
        <p class="kpi-n" style="font-size:24px">${cuenta[k]}</p>
        <p style="font-size:9px; letter-spacing:1.6px; color:var(--gray-2); margin-top:4px">${nom}</p>
      </div>`).join("");
  }
  function pintarTablero() {
    const t = $("#tablero"); t.textContent = "";
    COLS.forEach(([k, nom]) => {
      const col = document.createElement("div");
      col.className = "col-ful"; col.dataset.col = k;
      const suyos = DEMO.pedidos.filter(p => p.estado === k);
      col.innerHTML = `<h3>${nom} <b>${suyos.length}</b></h3>`;
      suyos.forEach(p => {
        const f = document.createElement("div");
        f.className = "ficha-ped"; f.draggable = true; f.dataset.ped = p.id;
        f.innerHTML = `<b>${p.id}</b><small>${p.quien}</small>`;
        f.addEventListener("dragstart", e => { f.classList.add("volando"); e.dataTransfer.setData("text/plain", p.id); });
        f.addEventListener("dragend", () => f.classList.remove("volando"));
        f.addEventListener("click", () => abrirPedido(p));
        col.appendChild(f);
      });
      col.addEventListener("dragover", e => { e.preventDefault(); col.classList.add("sobre"); });
      col.addEventListener("dragleave", () => col.classList.remove("sobre"));
      col.addEventListener("drop", e => {
        e.preventDefault(); col.classList.remove("sobre");
        const id = e.dataTransfer.getData("text/plain");
        const p = DEMO.pedidos.find(x => x.id === id);
        if (p && p.estado !== k) { p.estado = k; pintarTablero(); pintarTablas(); pintarFulMini(); toast(`${id} → ${nom}. (Demo)`); }
      });
      t.appendChild(col);
    });
  }
  function pintarEnvios() {
    $("#tablaEnvios tbody").innerHTML = DEMO.envios.map(([id, quien, seg, est, fecha]) =>
      `<tr><td><b>${id}</b></td><td>${quien}</td><td>${seg}…</td><td><span class="est ${est}">${TXT[est]}</span></td><td>${fecha}</td></tr>`).join("");
  }
  function pintarClientes() {
    $("#muro").innerHTML = DEMO.fundadores.map((f, i) =>
      `<div class="fundador"><svg style="color:${["var(--pink)", "var(--yellow)", "var(--cyan)"][i % 3]}"><use href="#bunny"/></svg><div><b>${f}</b><small>FUNDADOR ${String(67 - i).padStart(3, "0")}</small></div></div>`).join("");
    $("#tablaClientes tbody").innerHTML = DEMO.clientes.map(c =>
      `<tr><td><b>${c[0]}</b></td><td>${c[1]}</td><td><b>${c[2]}</b></td><td>${c[3]}</td><td>${c[4]}</td></tr>`).join("");
  }
  function pintarProductos() {
    $("#prodAdm").innerHTML = DEMO.productos.map(p => {
      const pct = Math.round(p.stock / p.max * 100);
      const clase = pct < 15 ? "baja" : pct < 45 ? "" : "ok";
      return `<div class="prod-fila">
        <h3>${p.n}<small>${p.v}</small></h3><span class="precio">${p.ventas} VENTAS/MES</span>
        <div class="prod-stock"><div class="barra ${clase}"><i data-w="${pct}%"></i></div><span>${p.stock} / ${p.max} UDS</span></div>
      </div>`;
    }).join("");
  }
  function pintarAnalytics() {
    const semanas = [3120, 2840, 3610, 3980];
    const max = Math.max(...semanas);
    $("#barrasSem").innerHTML = semanas.map((v, i) =>
      `<div style="flex:1; display:grid; grid-template-rows:1fr auto; gap:6px; height:100%">
        <div class="barraV" data-tip="${money(v)}" style="--d:${i * 120}ms; height:${Math.round(v / max * 100)}%; background:${i === semanas.length - 1 ? "var(--pink)" : "rgba(230,230,255,.14)"}"></div>
        <p style="text-align:center; font-size:9px; letter-spacing:1.5px; color:var(--gray-2)">SEM ${i + 1}</p>
      </div>`).join("");
    $("#porEstado").innerHTML = DEMO.porEstado.map(([n, v]) =>
      `<div><div class="tp-lab"><span>${n}</span><b>${v}%</b></div><div class="barra"><i data-w="${v * 4}%"></i></div></div>`).join("");
    $("#fuentes").innerHTML = DEMO.fuentes.map(([n, v]) =>
      `<div><div class="tp-lab"><span>${n}</span><b>${v}%</b></div><div class="barra"><i data-w="${v}%" style="background:var(--cyan)"></i></div></div>`).join("");
  }
  function pintarSoporte() {
    const caja = $("#hilos"); caja.textContent = "";
    DEMO.hilos.forEach((h, i) => {
      const d = document.createElement("div");
      d.className = "hilo" + (i === 0 ? " abierto" : "");
      d.innerHTML = `<b>${h.tema}</b><p>${h.de} — ${h.msgs[h.msgs.length - 1][1]}</p>`;
      d.addEventListener("click", () => { $$(".hilo").forEach(x => x.classList.remove("abierto")); d.classList.add("abierto"); pintarConversa(h); });
      caja.appendChild(d);
    });
    pintarConversa(DEMO.hilos[0]);
  }
  function pintarConversa(h) {
    $("#conversa").innerHTML = h.msgs.map(([quien, txt]) =>
      `<div class="burbuja ${quien === "yo" ? "mia" : ""}">${txt}</div>`).join("") +
      `<div style="display:flex; gap:8px; margin-top:14px">
        <input placeholder="RESPONDER…" style="flex:1; font-family:var(--f-ui); font-size:12px; color:var(--bone); background:var(--bg-dark); border:2px solid var(--line-dark); padding:10px 12px" aria-label="Responder">
        <button class="btn btn-pink" data-toast="Respuesta enviada. (Demo)">ENVIAR ▸</button>
      </div>`;
  }

  /* ══════════ la gráfica del héroe ══════════ */
  function dibujarRev(dias) {
    const svg = $("#grafRev"), serie = DEMO.series[dias];
    const W = 600, H = 190, m = 24;
    const max = Math.max(...serie) * 1.15;
    const X = i => m + i * (W - m * 2) / (serie.length - 1);
    const Y = v => H - 22 - v / max * (H - 44);
    const pts = serie.map((v, i) => [X(i), Y(v)]);
    const d = "M" + pts.map(p => p.map(n => n.toFixed(1)).join(",")).join(" L");
    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    svg.classList.remove("dibujada");
    svg.innerHTML = `
      <path class="area" fill="url(#gradRosa)" d="${d} L${X(serie.length - 1).toFixed(1)},${H - 20} L${X(0).toFixed(1)},${H - 20} Z"/>
      <path class="linea" d="${d}"/>
      <circle class="punto" r="4"/>
      <text class="eje" x="${m}" y="${H - 6}">HACE ${dias} DÍAS</text>
      <text class="eje" x="${W - m}" y="${H - 6}" text-anchor="end">HOY</text>`;
    const linea = $(".linea", svg);
    const largo = linea.getTotalLength();
    if (!reducido) {
      linea.style.strokeDasharray = largo;
      linea.style.strokeDashoffset = largo;
      linea.getBoundingClientRect();
      linea.style.transition = "stroke-dashoffset 1.1s var(--ease-snap)";
      linea.style.strokeDashoffset = "0";
    }
    requestAnimationFrame(() => svg.classList.add("dibujada"));
    /* el dedo sobre la gráfica: punto + tooltip */
    const tip = $("#tipGraf"), punto = $(".punto", svg);
    svg.onmousemove = e => {
      const r = svg.getBoundingClientRect();
      const i = Math.round((e.clientX - r.left) / r.width * (serie.length - 1));
      if (i < 0 || i >= serie.length) return;
      punto.setAttribute("cx", X(i)); punto.setAttribute("cy", Y(serie[i]));
      punto.classList.add("viva");
      tip.innerHTML = `<b>${money(serie[i])}</b> · día ${i + 1}`;
      tip.style.left = (X(i) / W * 100) + "%";
      tip.style.top = (Y(serie[i]) / H * 100 - 14) + "%";
      tip.classList.add("viva");
    };
    svg.onmouseleave = () => { punto.classList.remove("viva"); tip.classList.remove("viva"); };
  }
  $$("[data-per]").forEach(b => b.addEventListener("click", () => {
    $$("[data-per]").forEach(x => x.setAttribute("aria-selected", String(x === b)));
    dibujarRev(+b.dataset.per);
  }));

  /* chispas (sparklines) */
  function chispas() {
    $$(".chispa").forEach(svg => {
      const serie = svg.dataset.serie.split(",").map(Number);
      const max = Math.max(...serie), W = 86, H = 30;
      const pts = serie.map((v, i) => `${(i * W / (serie.length - 1)).toFixed(1)},${(H - 3 - v / max * (H - 6)).toFixed(1)}`).join(" ");
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      svg.innerHTML = `<polyline points="${pts}" style="stroke:${svg.dataset.color}"/>`;
    });
  }

  /* donuts */
  function donuts() {
    const C = 2 * Math.PI * 54;
    [["#donutConv", .28], ["#donutRec", .31]].forEach(([sel, frac]) => {
      const el = $(sel); if (!el) return;
      el.style.strokeDashoffset = C;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        el.style.strokeDashoffset = C * (1 - Math.min(1, frac));
      }));
    });
  }

  /* la cinta de operaciones */
  function cinta() {
    const trozos = [
      "PEDIDOS HOY <b>12</b>", "INGRESOS HOY <b>$487</b>", "FUNDADORES <b>67/100</b>",
      "STOCK RABBIT FUEL ×4 <b>18 UDS</b>", "EN TRÁNSITO <b>2</b>", "MES <b>$14,382</b>",
    ];
    $("#cinta").innerHTML = [...trozos, ...trozos].map(t => `<span>${t} ·</span>`).join("");
  }

  /* ══════════ modal de pedido ══════════ */
  let ultimoFoco = null;
  function abrirPedido(p) {
    ultimoFoco = document.activeElement;
    $("#mpTitulo").textContent = p.id;
    $("#mpQuien").textContent = p.quien + " · " + p.fecha;
    $("#mpLineas tbody").innerHTML = p.items.map(([n, c, pr]) =>
      `<tr><td><b>${n}</b></td><td>${c}</td><td>${money(pr * c)}</td></tr>`).join("");
    $("#mpTotal").textContent = money(total(p));
    const pasos = [["Pedido creado", true], ["Pago confirmado", true],
      ["En preparación", ["prepara", "empacado", "enviado", "entregado", "retraso"].includes(p.estado)],
      ["Con el transportista", ["enviado", "entregado", "retraso"].includes(p.estado)],
      ["Entregado", p.estado === "entregado"]];
    $("#mpTimeline").innerHTML = pasos.map(([n, hecho], i) =>
      `<li style="--i:${i}" class="${hecho ? "hito" : ""}"><span class="lt-punto"></span><div><p>${hecho ? "<b>" + n + "</b>" : n}</p><time>${hecho ? p.fecha : "PENDIENTE"}</time></div></li>`).join("");
    $("#velo").classList.add("abierto");
    $("#modalPed").classList.add("abierto");
    $("#mpCerrar").focus();
  }
  function cerrarPedido() {
    $("#velo").classList.remove("abierto");
    $("#modalPed").classList.remove("abierto");
    ultimoFoco?.focus();
  }
  $("#mpCerrar").addEventListener("click", cerrarPedido);
  $("#velo").addEventListener("click", cerrarPedido);
  document.addEventListener("keydown", e => { if (e.key === "Escape") { cerrarPedido(); $("#avisos").classList.remove("abierto"); } });

  /* ══════════ enrutado con transición + skeleton breve ══════════ */
  const NOMBRES = Object.fromEntries($$(".lado nav button").map(b => [b.dataset.mod, b.querySelector("span").textContent]));
  function moverHopper() {
    const activo = $('.lado nav button[aria-current="true"]');
    if (activo) $("#hopper").style.top = (activo.offsetTop + activo.offsetHeight / 2 - 7) + "px";
  }
  function abrir(id, primera = false) {
    if (!NOMBRES[id]) id = "resumen";
    $$(".mod").forEach(m => m.classList.toggle("activa", m.dataset.mod === id));
    $$(".lado nav button").forEach(b => b.setAttribute("aria-current", String(b.dataset.mod === id)));
    $("#tituloMod").textContent = NOMBRES[id].charAt(0) + NOMBRES[id].slice(1).toLowerCase();
    moverHopper();
    if (location.hash !== "#" + id) history.replaceState(null, "", "#" + id);
    const sec = $(`.mod[data-mod="${id}"]`);
    const arrancar = () => {
      revelar(sec);
      if (id === "resumen") { dibujarRev(+$('[data-per][aria-selected="true"]').dataset.per); donuts(); }
      if (id === "analytics") {
        donuts();
        $$("#barrasSem .barraV").forEach(b => b.classList.remove("crecida"));
        setTimeout(() => $$("#barrasSem .barraV").forEach(b => b.classList.add("crecida")), 250);
      }
    };
    if (!primera && !reducido) {
      /* skeleton de un latido: la casa enseña que está trabajando */
      const tarjs = $$(".tarj", sec);
      tarjs.forEach(t => t.classList.add("hueso"));
      setTimeout(() => { tarjs.forEach(t => t.classList.remove("hueso")); arrancar(); }, 240);
    } else arrancar();
    $("#app").classList.remove("lado-abierto");
    scrollTo({ top: 0, behavior: "instant" });
  }
  $$(".lado nav button").forEach(b => b.addEventListener("click", () => abrir(b.dataset.mod)));
  $$("[data-ir]").forEach(b => {
    b.addEventListener("click", () => abrir(b.dataset.ir));
    b.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); abrir(b.dataset.ir); } });
  });
  addEventListener("hashchange", () => abrir(location.hash.slice(1)));

  /* búsqueda: filtra pedidos y salta a la sección */
  $("#buscaGlobal").addEventListener("input", e => {
    const q = e.target.value.trim().toLowerCase();
    pintarTablas($('#filtroEstado [aria-selected="true"]')?.dataset.f || "", q);
    if (q && $(".mod.activa").dataset.mod !== "pedidos") abrir("pedidos");
  });
  document.addEventListener("keydown", e => {
    if (e.key === "/" && !/input|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); $("#buscaGlobal").focus(); }
  });
  $("#filtroEstado").addEventListener("click", e => {
    const b = e.target.closest("[data-f]"); if (!b) return;
    $$("#filtroEstado [data-f]").forEach(x => x.setAttribute("aria-selected", String(x === b)));
    pintarTablas(b.dataset.f, $("#buscaGlobal").value.trim().toLowerCase());
  });

  /* campana, palancas, plegado */
  $("#campana").addEventListener("click", e => {
    e.stopPropagation();
    const abierto = $("#avisos").classList.toggle("abierto");
    $("#campana").setAttribute("aria-expanded", String(abierto));
    if (abierto) $("#campanaN").style.display = "none";
  });
  document.addEventListener("click", e => { if (!e.target.closest("#avisos, #campana")) $("#avisos").classList.remove("abierto"); });
  document.addEventListener("click", e => {
    const p = e.target.closest(".inter");
    if (p) p.setAttribute("aria-pressed", String(p.getAttribute("aria-pressed") !== "true"));
  });
  $("#pliega").addEventListener("click", () => {
    const app = $("#app");
    if (matchMedia("(max-width: 860px)").matches) app.classList.toggle("lado-abierto");
    else { app.classList.toggle("plegada"); setTimeout(moverHopper, 380); }
  });

  /* ══════════ LA PUERTA ══════════ */
  const negar = (t, x, enlace) => {
    $("#puertaTitulo").textContent = t;
    $("#puertaTexto").textContent = x;
    $("#puertaAccion").innerHTML = enlace || "";
  };
  (async () => {
    if (!PK) return negar("SIN CONFIGURAR", "Falta la clave publicable de Clerk.");
    let clerk;
    try {
      const { Clerk } = await import("@clerk/clerk-js");
      clerk = new Clerk(PK);
      await Promise.race([clerk.load(), new Promise((_, no) => setTimeout(() => no(new Error("tiempo")), 15000))]);
    } catch {
      return negar("SIN CONEXIÓN", "No se pudo comprobar la sesión. Recarga para intentarlo otra vez.");
    }
    const u = clerk.user;
    if (!u) return negar("HACE FALTA SESIÓN", "Este panel es solo del equipo. Entra con tu cuenta en la tienda y vuelve.", '<a href="/#micuenta">Ir a entrar →</a>');
    /* publicMetadata solo lo escribe el servidor. Y aun así: esta capa decide
       qué se PINTA; las acciones reales del futuro se verificarán por petición. */
    if (u.publicMetadata?.admin !== true)
      return negar("SOLO EQUIPO", "Tu cuenta no tiene acceso al panel interno. Si deberías tenerlo, pide el alta.", '<a href="/">Volver a la tienda →</a>');

    $("#quien").textContent = u.primaryEmailAddress?.emailAddress || "";
    $("#puerta").style.display = "none";
    $("#app").classList.add("abierta");
    $("#salir").addEventListener("click", async () => { try { await clerk.signOut(); location.href = "/"; } catch {} });

    /* pintar todo y arrancar */
    cinta(); chispas(); pintarTablas(); pintarActividad(); pintarStock();
    pintarFulMini(); pintarTablero(); pintarEnvios(); pintarClientes();
    pintarProductos(); pintarAnalytics(); pintarSoporte();
    contar($("#revTotal"), +$("#revTotal").dataset.n, 1200);
    abrir(location.hash.slice(1) || "resumen", true);
  })();
</script>
</body>
</html>
