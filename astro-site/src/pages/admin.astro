  const $ = (s, c = document) => c.querySelector(s);
  const $$ = (s, c = document) => [...c.querySelectorAll(s)];
  const reducido = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ══════════ DATOS DE EJEMPLO ══════════ */
  const DEMO = {
