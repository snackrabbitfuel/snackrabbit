        f.className = "ficha-ped"; f.draggable = true; f.dataset.ped = p.id;
        f.innerHTML = `<b>${p.id}</b><small>${p.quien}</small>`;
        f.addEventListener("dragstart", e => { f.classList.add("volando"); e.dataTransfer.setData("text/plain", p.id); });
        f.addEventListener("dragend", () => f.classList.remove("volando"));
        f.addEventListener("click", () => abrirPedido(p));
        col.appendChild(f);
      });
      col.addEventListener("dragover", e => { e.preventDefault(); col.classList.add("sobre"); });
      col.addEventListener("dragleave", () => col.classList.remove("sobre"));
      col.addEventListener("drop", e => {
        e.preventDefault(); col.classList.remove("sobre");
        const id = e.dataTransfer.getData("text/plain");
        const p = DEMO.pedidos.find(x => x.id === id);
        if (p && p.estado !== k) { p.estado = k; pintarTablero(); pintarTablas(); pintarFulMini(); toast(`${id} → ${nom}. (Demo)`); }
      });
      t.appendChild(col);
    });
  }
  function pintarEnvios() {
    $("#tablaEnvios tbody").innerHTML = DEMO.envios.map(([id, quien, seg, est, fecha]) =>
      `<tr><td><b>${id}</b></td><td>${quien}</td><td>${seg}…</td><td><span class="est ${est}">${TXT()[est]}</span></td><td>${fecha}</td></tr>`).join("");
  }
  function pintarClientes() {
    $("#muro").innerHTML = DEMO.fundadores.map((f, i) =>
      `<div class="fundador"><svg style="color:${["var(--pink)", "var(--yellow)", "var(--cyan)"][i % 3]}"><use href="#bunny"/></svg><div><b>${f}</b><small>${T("cu.founder")} ${String(67 - i).padStart(3, "0")}</small></div></div>`).join("");
    $("#tablaClientes tbody").innerHTML = DEMO.clientes.map(c =>
      `<tr><td><b>${c[0]}</b></td><td>${c[1]}</td><td><b>${c[2]}</b></td><td>${c[3] || T("cl.today")}</td><td>${c[4]}</td></tr>`).join("");
  }
  function pintarProductos() {
    $("#prodAdm").innerHTML = DEMO.productos.map(p => {
      const pct = Math.round(p.stock / p.max * 100);
      const clase = pct < 15 ? "baja" : pct < 45 ? "" : "ok";
      return `<div class="prod-fila">
        <h3>${p.n}<small>${p.v}</small></h3><span class="precio">${p.ventas} ${T("pr.sales")}</span>
        <div class="prod-stock"><div class="barra ${clase}"><i data-w="${pct}%"></i></div><span>${p.stock} / ${p.max} ${T("pr.units")}</span></div>
      </div>`;
    }).join("");
  }
  function pintarAnalytics() {
    const semanas = [3120, 2840, 3610, 3980];
    const max = Math.max(...semanas);
    $("#barrasSem").innerHTML = semanas.map((v, i) =>
      `<div style="flex:1; display:grid; grid-template-rows:1fr auto; gap:6px; height:100%">
        <div class="barraV" data-tip="${money(v)}" style="--d:${i * 120}ms; height:${Math.round(v / max * 100)}%; background:${i === semanas.length - 1 ? "var(--pink)" : "rgba(230,230,255,.14)"}"></div>
        <p style="text-align:center; font-size:9px; letter-spacing:1.5px; color:var(--gray-2)">${T("an.wk")} ${i + 1}</p>
      </div>`).join("");
    $("#porEstado").innerHTML = DEMO.porEstado.map(([n, v]) =>
      `<div><div class="tp-lab"><span>${n.includes(".") ? T(n) : n}</span><b>${v}%</b></div><div class="barra"><i data-w="${v * 4}%"></i></div></div>`).join("");
    $("#fuentes").innerHTML = DEMO.fuentes.map(([n, v]) =>
      `<div><div class="tp-lab"><span>${T(n)}</span><b>${v}%</b></div><div class="barra"><i data-w="${v}%" style="background:var(--cyan)"></i></div></div>`).join("");
  }
  function pintarSoporte() {
    const caja = $("#hilos"); caja.textContent = "";
    DEMO.hilos.forEach((h, i) => {
      const d = document.createElement("div");
      d.className = "hilo" + (i === 0 ? " abierto" : "");
      d.innerHTML = `<b>${h.tema}</b><p>${h.de} — ${h.msgs[h.msgs.length - 1][1]}</p>`;
      d.addEventListener("click", () => { $$(".hilo").forEach(x => x.classList.remove("abierto")); d.classList.add("abierto"); pintarConversa(h); });
      caja.appendChild(d);
    });
    pintarConversa(DEMO.hilos[0]);
  }
  function pintarConversa(h) {
    $("#conversa").innerHTML = h.msgs.map(([quien, txt]) =>
      `<div class="burbuja ${quien === "yo" ? "mia" : ""}">${txt}</div>`).join("") +
      `<div style="display:flex; gap:8px; margin-top:14px">
        <input placeholder="${T('su.reply')}" style="flex:1; font-family:var(--f-ui); font-size:12px; color:var(--bone); background:var(--bg-dark); border:2px solid var(--line-dark); padding:10px 12px" aria-label="Reply">
        <button class="btn btn-pink" data-toast="${T('su.sent')}">${T('su.send')}</button>
      </div>`;
  }

  /* ══════════ la gráfica del héroe ══════════ */
  function dibujarRev(dias) {
    const svg = $("#grafRev"), serie = DEMO.series[dias];
    const W = 600, H = 190, m = 24;
    const max = Math.max(...serie) * 1.15;
    const X = i => m + i * (W - m * 2) / (serie.length - 1);
    const Y = v => H - 22 - v / max * (H - 44);
    const pts = serie.map((v, i) => [X(i), Y(v)]);
    const d = "M" + pts.map(p => p.map(n => n.toFixed(1)).join(",")).join(" L");
    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    svg.classList.remove("dibujada");
    svg.innerHTML = `
      <path class="area" fill="url(#gradRosa)" d="${d} L${X(serie.length - 1).toFixed(1)},${H - 20} L${X(0).toFixed(1)},${H - 20} Z"/>
      <path class="linea" d="${d}"/>
      <circle class="punto" r="4"/>
      <text class="eje" x="${m}" y="${H - 6}">${dias} ${T("ov.daysAgo")}</text>
      <text class="eje" x="${W - m}" y="${H - 6}" text-anchor="end">${T("ov.today")}</text>`;
    const linea = $(".linea", svg);
    const largo = linea.getTotalLength();
    if (!reducido) {
      linea.style.strokeDasharray = largo;
      linea.style.strokeDashoffset = largo;
      linea.getBoundingClientRect();
      linea.style.transition = "stroke-dashoffset 1.1s var(--ease-snap)";
      linea.style.strokeDashoffset = "0";
    }
    requestAnimationFrame(() => svg.classList.add("dibujada"));
    /* el dedo sobre la gráfica: punto + tooltip */
    const tip = $("#tipGraf"), punto = $(".punto", svg);
    svg.onmousemove = e => {
      const r = svg.getBoundingClientRect();
      const i = Math.round((e.clientX - r.left) / r.width * (serie.length - 1));
      if (i < 0 || i >= serie.length) return;
      punto.setAttribute("cx", X(i)); punto.setAttribute("cy", Y(serie[i]));
      punto.classList.add("viva");
      tip.innerHTML = `<b>${money(serie[i])}</b> · ${T("ov.day")} ${i + 1}`;
      tip.style.left = (X(i) / W * 100) + "%";
      tip.style.top = (Y(serie[i]) / H * 100 - 14) + "%";
      tip.classList.add("viva");
    };
    svg.onmouseleave = () => { punto.classList.remove("viva"); tip.classList.remove("viva"); };
  }
  $$("[data-per]").forEach(b => b.addEventListener("click", () => {
    $$("[data-per]").forEach(x => x.setAttribute("aria-selected", String(x === b)));
    dibujarRev(+b.dataset.per);
  }));

  /* chispas (sparklines) */
  function chispas() {
    $$(".chispa").forEach(svg => {
      const serie = svg.dataset.serie.split(",").map(Number);
      const max = Math.max(...serie), W = 86, H = 30;
      const pts = serie.map((v, i) => `${(i * W / (serie.length - 1)).toFixed(1)},${(H - 3 - v / max * (H - 6)).toFixed(1)}`).join(" ");
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      svg.innerHTML = `<polyline points="${pts}" style="stroke:${svg.dataset.color}"/>`;
    });
  }

  /* donuts */
  function donuts() {
    const C = 2 * Math.PI * 54;
    [["#donutConv", .28], ["#donutRec", .31]].forEach(([sel, frac]) => {
      const el = $(sel); if (!el) return;
      el.style.strokeDashoffset = C;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        el.style.strokeDashoffset = C * (1 - Math.min(1, frac));
      }));
    });
  }

  /* la cinta de operaciones */
  function cinta() {
    const trozos = [
      `${T("tick.orders")} <b>12</b>`, `${T("tick.revenue")} <b>$487</b>`, `${T("tick.founders")} <b>67/100</b>`,
      `${T("tick.stock")} <b>18 ${T("tick.units")}</b>`, `${T("tick.transit")} <b>2</b>`, `${T("tick.month")} <b>$14,382</b>`,
    ];
    $("#cinta").innerHTML = [...trozos, ...trozos].map(t => `<span>${t} ·</span>`).join("");
  }

  /* ══════════ modal de pedido ══════════ */
  let ultimoFoco = null;
  function abrirPedido(p) {
    ultimoFoco = document.activeElement;
    $("#mpTitulo").textContent = p.id;
    $("#mpQuien").textContent = p.quien + " · " + p.fecha;
    $("#mpLineas tbody").innerHTML = p.items.map(([n, c, pr]) =>
      `<tr><td><b>${n}</b></td><td>${c}</td><td>${money(pr * c)}</td></tr>`).join("");
    $("#mpTotal").textContent = money(total(p));
    const pasos = [[T("mp.created"), true], [T("mp.confirmed"), true],
      [T("mp.packing"), ["prepara", "empacado", "enviado", "entregado", "retraso"].includes(p.estado)],
      [T("mp.carrier"), ["enviado", "entregado", "retraso"].includes(p.estado)],
      [T("mp.delivered"), p.estado === "entregado"]];
    $("#mpTimeline").innerHTML = pasos.map(([n, hecho], i) =>
      `<li style="--i:${i}" class="${hecho ? "hito" : ""}"><span class="lt-punto"></span><div><p>${hecho ? "<b>" + n + "</b>" : n}</p><time>${hecho ? p.fecha : T("mp.pending")}</time></div></li>`).join("");
    $("#velo").classList.add("abierto");
    $("#modalPed").classList.add("abierto");
    $("#mpCerrar").focus();
  }
  function cerrarPedido() {
    $("#velo").classList.remove("abierto");
    $("#modalPed").classList.remove("abierto");
    ultimoFoco?.focus();
  }
  $("#mpCerrar").addEventListener("click", cerrarPedido);
  $("#velo").addEventListener("click", cerrarPedido);
  document.addEventListener("keydown", e => { if (e.key === "Escape") { cerrarPedido(); $("#avisos").classList.remove("abierto"); } });

  /* ══════════ enrutado con transición + skeleton breve ══════════ */
  /* Los nombres salen del diccionario y no del texto del botón: si salieran
     del DOM, cambiar de idioma dejaría el título en el idioma anterior. */
  const NOMBRES = Object.fromEntries($$(".lado nav button").map(b => [b.dataset.mod, b.dataset.mod]));
  function moverHopper() {
    const activo = $('.lado nav button[aria-current="true"]');
    if (activo) $("#hopper").style.top = (activo.offsetTop + activo.offsetHeight / 2 - 7) + "px";
  }
  function abrir(id, primera = false) {
    if (!NOMBRES[id]) id = "overview";
    $$(".mod").forEach(m => m.classList.toggle("activa", m.dataset.mod === id));
    $$(".lado nav button").forEach(b => b.setAttribute("aria-current", String(b.dataset.mod === id)));
    $("#tituloMod").textContent = T("t." + id);
    moverHopper();
    if (location.hash !== "#" + id) history.replaceState(null, "", "#" + id);
    const sec = $(`.mod[data-mod="${id}"]`);
    const arrancar = () => {
      revelar(sec);
      if (id === "overview") { dibujarRev(+$('[data-per][aria-selected="true"]').dataset.per); donuts(); }
      if (id === "analytics") {
        donuts();
        $$("#barrasSem .barraV").forEach(b => b.classList.remove("crecida"));
        setTimeout(() => $$("#barrasSem .barraV").forEach(b => b.classList.add("crecida")), 250);
      }
    };
    if (!primera && !reducido) {
      /* skeleton de un latido: la casa enseña que está trabajando */
      const tarjs = $$(".tarj", sec);
      tarjs.forEach(t => t.classList.add("hueso"));
      setTimeout(() => { tarjs.forEach(t => t.classList.remove("hueso")); arrancar(); }, 240);
    } else arrancar();
    $("#app").classList.remove("lado-abierto");
    scrollTo({ top: 0, behavior: "instant" });
  }
  $$(".lado nav button").forEach(b => b.addEventListener("click", () => abrir(b.dataset.mod)));
  $$("[data-ir]").forEach(b => {
    b.addEventListener("click", () => abrir(b.dataset.ir));
    b.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); abrir(b.dataset.ir); } });
  });
  addEventListener("hashchange", () => abrir(location.hash.slice(1)));

  /* búsqueda: filtra pedidos y salta a la sección */
  $("#buscaGlobal").addEventListener("input", e => {
    const q = e.target.value.trim().toLowerCase();
    pintarTablas($('#filtroEstado [aria-selected="true"]')?.dataset.f || "", q);
    if (q && $(".mod.activa").dataset.mod !== "orders") abrir("orders");
  });
  document.addEventListener("keydown", e => {
    if (e.key === "/" && !/input|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); $("#buscaGlobal").focus(); }
  });
  $("#filtroEstado").addEventListener("click", e => {
    const b = e.target.closest("[data-f]"); if (!b) return;
    $$("#filtroEstado [data-f]").forEach(x => x.setAttribute("aria-selected", String(x === b)));
    pintarTablas(b.dataset.f, $("#buscaGlobal").value.trim().toLowerCase());
  });

  /* campana, palancas, plegado */
  $("#campana").addEventListener("click", e => {
    e.stopPropagation();
    const abierto = $("#avisos").classList.toggle("abierto");
    $("#campana").setAttribute("aria-expanded", String(abierto));
    if (abierto) $("#campanaN").style.display = "none";
  });
  document.addEventListener("click", e => { if (!e.target.closest("#avisos, #campana")) $("#avisos").classList.remove("abierto"); });
  document.addEventListener("click", e => {
    const p = e.target.closest(".inter");
    if (p) p.setAttribute("aria-pressed", String(p.getAttribute("aria-pressed") !== "true"));
  });
  /* Todo lo que se pinta desde datos, en un solo sitio: lo llama el arranque
     y lo vuelve a llamar el cambio de idioma. Sin esto habría que acordarse
     de repintar cada módulo a mano y siempre se olvida uno. */
  function pintarTodo() {
    cinta(); chispas(); pintarTablas(); pintarActividad(); pintarStock();
    pintarFulMini(); pintarTablero(); pintarEnvios(); pintarClientes();
    pintarProductos(); pintarAnalytics(); pintarSoporte();
  }

  /* El cambio de idioma: instantáneo y sin recargar. Se guarda la elección, se
     traduce el marcado y se repinta lo que sale de datos; el módulo abierto se
     queda abierto y el desplazamiento no se mueve. */
  $$("[data-lang]").forEach(b => b.addEventListener("click", () => {
    if (b.dataset.lang === LANG) return;
    LANG = b.dataset.lang;
    try { localStorage.setItem("sr_admin_lang_v1", LANG); } catch { /* privada */ }
    aplicarIdioma();
    pintarTodo();
    const activo = $(".mod.activa");
    if (activo) {
      revelar(activo);
      const id = activo.dataset.mod;
      if (id === "overview") { dibujarRev(+$('[data-per][aria-selected="true"]').dataset.per); donuts(); }
      if (id === "analytics") {
        donuts();
        $$("#barrasSem .barraV").forEach(x => x.classList.remove("crecida"));
        setTimeout(() => $$("#barrasSem .barraV").forEach(x => x.classList.add("crecida")), 200);
      }
    }
  }));

  $("#pliega").addEventListener("click", () => {
    const app = $("#app");
    if (matchMedia("(max-width: 860px)").matches) app.classList.toggle("lado-abierto");
    else { app.classList.toggle("plegada"); setTimeout(moverHopper, 380); }
  });

  /* ══════════ LA PUERTA ══════════ */
  const negar = (t, x, enlace) => {
    $("#puertaTitulo").textContent = t;
    $("#puertaTexto").textContent = x;
    $("#puertaAccion").innerHTML = enlace || "";
  };
  /* La puerta se traduce ya: quien no pase de aquí también merece leerlo en
     su idioma. */
  aplicarIdioma();

  (async () => {
    if (!PK) return negar(T("gate.noconf"), T("gate.noconfTxt"));
    let clerk;
    try {
      const { Clerk } = await import("@clerk/clerk-js");
      clerk = new Clerk(PK);
      await Promise.race([clerk.load(), new Promise((_, no) => setTimeout(() => no(new Error("tiempo")), 15000))]);
    } catch {
      return negar(T("gate.noconn"), T("gate.noconnTxt"));
    }
    const u = clerk.user;
    if (!u) return negar(T("gate.signin"), T("gate.signinTxt"), '<a href="/#micuenta">' + T("gate.signinCta") + '</a>');

    /* LA DECISIÓN NO ES DE ESTE CÓDIGO.
     *
     * Antes se comprobaba publicMetadata aquí y punto. El problema es que este
     * archivo corre en el navegador de quien lo abre: cambiar un `if` en la
     * consola es trivial, y con eso se veían los datos aunque no se pudiera
     * hacer nada con ellos. Ahora se le pregunta al servidor, que verifica el
     * token con la clave secreta de Clerk y saca el correo de la CUENTA, no de
     * lo que mande el navegador. Falsear esto exigiría falsificar una firma de
     * Clerk, que es exactamente el punto.
     *
     * Y si la respuesta es que no: no se pinta nada. Se rebota al panel del
     * cliente, que es donde esa persona sí tiene sitio. */
    let respuesta;
    try {
      const token = await clerk.session?.getToken();
      const r = await fetch("/api/admin", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ token }),
      });
      respuesta = await r.json();
    } catch {
      return negar(T("gate.noconn"), T("gate.noconnTxt"));
    }
    if (!respuesta?.admin) {
      negar(T("gate.denied"), T("gate.deniedTxt"), '<a href="/#micuenta">' + T("gate.deniedCta") + '</a>');
      /* Rebote automático: la persona tiene cuenta, solo que no es de las
         nuestras. Se le da un segundo para leer el mensaje y se le lleva a su
         panel en vez de dejarla mirando una pared. */
      setTimeout(() => { location.href = "/#micuenta"; }, 2600);
      return;
    }

    $("#quien").textContent = respuesta.correo || u.primaryEmailAddress?.emailAddress || "";
    $("#puerta").style.display = "none";
    $("#app").classList.add("abierta");
    $("#salir").addEventListener("click", async () => { try { await clerk.signOut(); location.href = "/"; } catch {} });

    /* pintar todo y arrancar */
    aplicarIdioma();
    pintarTodo();
    contar($("#revTotal"), +$("#revTotal").dataset.n, 1200);
    abrir(location.hash.slice(1) || "overview", true);
  })();
</script>
</body>
</html>
