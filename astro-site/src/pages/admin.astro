  /* ══════════ utilidades de vida ══════════ */
  function contar(el, fin, dur = 900) {
    if (reducido) { el.textContent = fin.toLocaleString("en-US"); return; }
    const t0 = performance.now();
    const paso = t => {
      const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      el.textContent = Math.round(fin * e).toLocaleString("en-US");
      if (k < 1) requestAnimationFrame(paso);
      else { el.classList.add("late-pop"); setTimeout(() => el.classList.remove("late-pop"), 600); }
    };
    requestAnimationFrame(paso);
  }
  function toast(msg) {
    const t = document.createElement("div");
    t.className = "toast";
    t.innerHTML = '<svg><use href="#bunny"/></svg><span></span>';
    t.lastElementChild.textContent = msg;
    $("#toasts").appendChild(t);
    setTimeout(() => { t.classList.add("fuera"); setTimeout(() => t.remove(), 400); }, 3400);
  }
  document.addEventListener("click", e => {
    /* data-ttoast lleva una clave (se traduce al pulsar, con el idioma vivo);
       data-toast lleva el texto ya hecho, para lo que pinta el JS. */
    const b = e.target.closest("[data-toast], [data-ttoast]");
    if (b) toast(b.dataset.ttoast ? T(b.dataset.ttoast) : b.dataset.toast);
  });

  /* revelado escalonado al entrar cada sección */
  function revelar(sec) {
    $$(".rv", sec).forEach(el => el.classList.remove("in"));
    requestAnimationFrame(() => requestAnimationFrame(() =>
      $$(".rv", sec).forEach(el => el.classList.add("in"))));
    $$("[data-cuenta]", sec).forEach(el => contar(el, +el.dataset.cuenta));
    $$(".barra i[data-w]", sec).forEach(i => { i.style.width = "0"; requestAnimationFrame(() => requestAnimationFrame(() => { i.style.width = i.dataset.w; })); });
    $$(".linea-t li", sec).forEach(li => { li.style.animation = "none"; void li.offsetWidth; li.style.animation = ""; });
  }

  /* ══════════ pintado con datos DEMO ══════════ */
  function filaPedido(p, corta = false) {
    const tr = document.createElement("tr");
    tr.dataset.ped = p.id;
    const celdas = corta
      ? [`<b>${p.id}</b>`, p.quien.split(" · ")[0], `<b>${money(total(p))}</b>`, `<span class="est ${p.estado}">${TXT()[p.estado]}</span>`]
      : [`<b>${p.id}</b>`, p.quien, p.items.map(i => i[0]).join(" + "), `<b>${money(total(p))}</b>`, `<span class="est ${p.estado}">${TXT[p.estado]}</span>`, p.fecha];
    tr.innerHTML = celdas.map(c => `<td>${c}</td>`).join("");
    tr.addEventListener("click", () => abrirPedido(p));
    return tr;
  }
  function pintarTablas(filtro = "", busca = "") {
    const tb1 = $("#tablaResumen tbody"), tb2 = $("#tablaPedidos tbody");
    tb1.textContent = ""; tb2.textContent = "";
    DEMO.pedidos.slice(0, 5).forEach(p => tb1.appendChild(filaPedido(p, true)));
    DEMO.pedidos
      .filter(p => !filtro || p.estado === filtro)
      .filter(p => !busca || (p.id + p.quien).toLowerCase().includes(busca))
      .forEach(p => tb2.appendChild(filaPedido(p)));
  }
