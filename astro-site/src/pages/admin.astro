  /* Aplica el idioma a todo el marcado etiquetado. Los cuatro atributos
     cubren texto, marcador de posición, etiqueta accesible y tooltip; los
     toasts se resuelven al pulsar, no aquí. */
  function aplicarIdioma() {
    $$("[data-t]").forEach(el => { el.textContent = T(el.dataset.t); });
    $$("[data-tph]").forEach(el => { el.placeholder = T(el.dataset.tph); });
    $$("[data-taria]").forEach(el => { el.setAttribute("aria-label", T(el.dataset.taria)); });
    $$("[data-ttip]").forEach(el => { el.dataset.tip = T(el.dataset.ttip); });
    document.documentElement.lang = LANG;
    $$("[data-lang]").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.lang === LANG)));
    const activo = $('.lado nav button[aria-current="true"]');
    if (activo) $("#tituloMod").textContent = T("t." + activo.dataset.mod);
  }

