---
/* MY BURROW — el panel del cliente.
   No es una pantalla de ajustes: es un sitio al que se baja. El orden va de
   identidad (quién eres y qué rango tienes) a colección, descenso y, al final,
   lo administrativo. Lo rellena el módulo Panel de app.js desde el perfil de
   Clerk; lo que aún no existe se enseña vacío, nunca inventado. */
const CARTAS = Array.from({ length: 12 }, (_, i) => i);
const MESES = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
               "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
/* Único sitio donde viven los umbrales: app.js los importa de aquí. Estaban
   escritos dos veces, y dos copias del mismo número siempre acaban separándose
   sin que nadie se entere. */
import { UMBRALES_RANGO as RANGOS } from "../data/rangos";
const ROMANOS = ["I", "II", "III", "IV", "V", "VI"];
---

<!-- ============ PANEL DE CLIENTE ============ -->
<div class="modal panel-modal" id="panelModal" role="dialog" aria-modal="true" aria-labelledby="pnTitle" hidden>
  <button class="modal-x" data-close data-i18n-aria="aria.close" aria-label="Close">✕</button>
  <div class="pn-mesh" aria-hidden="true"></div>

  <!-- ---- Identidad: el rango es lo primero y lo más grande ---- -->
  <header class="pn-head" style="--i:0">
    <div class="pn-quien">
      <svg class="pn-bunny" aria-hidden="true"><use href="#bunny"></use></svg>
      <div>
        <p class="pn-kicker" id="pnTitle" data-i18n="pn.title">MY BURROW</p>
        <p class="pn-user" id="pnUser"></p>
      </div>
    </div>

    <div class="pn-rango-hero">
      <p class="pn-rango-lab" data-i18n="pn.rank">YOUR RANK</p>
      <p class="pn-rango-n" id="pnRangoN">—</p>
      <div class="pn-barra"><span id="pnRangoFill"></span></div>
      <p class="pn-rango-nota" id="pnRangoNota"></p>
    </div>
  </header>

  <div class="pn-body">
    <!-- ---- El año ---- -->
    <section class="pn-bloque" style="--i:1">
      <div class="pn-h3"><span data-i18n="pn.cards">YOUR YEAR</span><b><i id="pnCartasN">0</i> / 12</b></div>
      <ol class="pn-cartas">
        {CARTAS.map((i) => (
          <li class="pn-carta" data-carta={i + 1} style={`--i:${i}`}>
            <span class="pn-c-n">{String(i + 1).padStart(3, "0")}</span>
            <span class="pn-c-mes" data-mes={i}>{MESES[i]}</span>
          </li>
        ))}
      </ol>
      <p class="pn-nota" id="pnCartasNota" data-i18n="pn.cardsEmpty">Your cards show up here as they ship, one a month.</p>
    </section>

    <!-- ---- El descenso ---- -->
    <section class="pn-bloque" style="--i:2">
      <div class="pn-h3"><span data-i18n="pn.descent">THE DESCENT</span><b><i id="pnLatasN">0</i> <span data-i18n="pn.cans">CANS</span></b></div>
      <ol class="pn-escalera">
        {RANGOS.map((latas, i) => (
          <li class="pn-peldano" data-rango={i} style={`--i:${i}`}>
            <span class="pn-rom">{ROMANOS[i]}</span>
            <span class="pn-r-nombre" data-i18n={`rank.${i + 1}`}></span>
            <span class="pn-r-latas">{latas}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- ---- Pedidos ---- -->
    <section class="pn-bloque" style="--i:3">
      <div class="pn-h3"><span data-i18n="pn.orders">ORDERS</span><b id="pnPedidosN"></b></div>
      <div id="pnPedidos"></div>
    </section>

    <!-- ---- Lo administrativo, al fondo ---- -->
    <div class="pn-dos" style="--i:4">
      <section class="pn-bloque">
        <div class="pn-h3"><span data-i18n="pn.member">MEMBERSHIP</span></div>
        <p class="pn-dato" id="pnMembresia"></p>
        <!-- Los Términos y la política de devoluciones prometen que se puede
             cancelar desde aquí, y hasta ahora aquí no había nada. El enlace se
             pinta desde app.js: mientras no exista Stripe apunta al correo, y
             el día que exista abrirá el portal del cliente. -->
        <p class="pn-nota" id="pnGestion"></p>
      </section>
      <section class="pn-bloque">
        <div class="pn-h3"><span data-i18n="pn.ship">SHIPPING</span></div>
        <p class="pn-dato" id="pnEnvio"></p>
        <!-- Sin esto, la dirección solo se podía cambiar haciendo otro pedido:
             quien se muda a mitad de suscripción no tenía forma de corregirla,
             y las cajas salen todos los meses. -->
        <button class="pn-editar" id="pnEditar" type="button" data-i18n="pn.editShip">CHANGE ADDRESS</button>
        <form class="pn-form" id="pnFormEnvio" hidden novalidate>
          <label><span data-i18n="ck.name">FULL NAME</span><input name="name" autocomplete="name" required></label>
          <label><span data-i18n="ck.phone">PHONE</span><input name="phone" autocomplete="tel" required></label>
          <label class="pn-ancho"><span data-i18n="ck.address">ADDRESS</span><input name="address" autocomplete="street-address" required></label>
          <label><span data-i18n="ck.city">CITY</span><input name="city" autocomplete="address-level2" required></label>
          <label><span data-i18n="ck.zip">POSTAL CODE</span><input name="zip" autocomplete="postal-code" required></label>
          <label class="pn-ancho"><span data-i18n="ck.country">COUNTRY</span><input name="country" autocomplete="country-name" required></label>
          <p class="lm-err pn-ancho" role="alert"></p>
          <div class="pn-form-btns pn-ancho">
            <button class="btn btn-pink lm-submit" type="submit" data-i18n="pn.saveShip">SAVE ADDRESS</button>
            <button class="pn-editar" type="button" id="pnCancelar" data-i18n="pn.cancelShip">CANCEL</button>
          </div>
        </form>
      </section>
    </div>
  </div>

  <footer class="pn-pie">
    <span class="pn-pie-marca">SNACKRABBIT · LA MADRIGUERA</span>
    <button class="pn-salir" id="pnSalir" type="button" data-i18n="pn.out">LOG OUT</button>
  </footer>
</div>
