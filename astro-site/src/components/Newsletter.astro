<!-- ============ NEWSLETTER ============ -->
<section class="news" id="newsletter">
  <div class="news-inner rv">
    <svg class="news-bunny" aria-hidden="true"><use href="#bunny"></use></svg>
    <h2 class="news-title" data-i18n-html="news.title">JOIN<br>THE LIST</h2>
    <p class="news-sub" data-i18n="news.sub">One email a month: drops, curiosities, zero spam.</p>
    <form class="news-form" id="newsForm" novalidate>
      <input type="email" id="newsEmail" name="email" placeholder="YOU@EMAIL.COM" data-i18n-ph="news.ph" aria-label="Email" required>
      <button class="btn btn-ink" type="submit" data-i18n="news.btn">SUBSCRIBE ▸</button>
    </form>
    <p class="news-msg" id="newsMsg" role="status"></p>
  </div>
</section>
