import Faq from "./Faq.astro";
---

<!-- ============ MANIFIESTO ============ -->
<section class="paper" id="historia">
  <div class="paper-inner">
    <div class="mani-copy">
      <p class="sec-kicker dark rv" data-i18n="mani.kicker">MANIFIESTO</p>
      <h2 class="sec-title dark rv" data-delay="80" data-i18n-html="mani.title">CURIOSIDAD,<br>PERO <em class="hl">EN FÍSICO.</em></h2>
      <p class="mani-text rv" data-delay="160" data-i18n-html="mani.text">SnackRabbit nació contando curiosidades de 60 segundos. <strong>DROP 001</strong> es exactamente lo mismo, pero en objetos: una lata que no te miente, una toalla que ha visto más scroll que sudor y un conejo de peluche que te mira mientras trabajas.</p>
      <ul class="facts">
        <li class="rv" data-delay="220" data-i18n="mani.fact1">LA YERBA MATE TIENE MÁS ANTIOXIDANTES QUE EL TÉ VERDE.</li>
        <li class="rv" data-delay="300" data-i18n="mani.fact2">UNA SEMILLA DE GUARANÁ TIENE ~2× LA CAFEÍNA DE UN GRANO DE CAFÉ.</li>
        <li class="rv" data-delay="380" data-i18n="mani.fact3">LOS CONEJOS PUEDEN VER CASI 360°. NOSOTROS, SOLO ESTE DROP.</li>
      </ul>
    </div>
    <figure class="mani-sticker rv" data-delay="200" aria-hidden="true">
      <img src="/assets/logo-snackrabbit-rosa-1080.png" alt="">
      <span class="hv-tape hv-tape-a"></span>
      <figcaption>EST. 2023 · 100% REAL</figcaption>
    </figure>
  </div>

  <Faq />
</section>
