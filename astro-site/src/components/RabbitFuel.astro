<!-- ============ RABBIT FUEL ============ -->
<section class="fuel" id="fuel">
  <div class="fuel-inner">
    <div class="fuel-visual rv">
      <figure class="fuel-can-wrap" id="fuelCan" title="PSSHT!">
        <img src="/assets/can-tight.jpg" alt="Rabbit Fuel 250 ml — Natural Energy, mate + guaraná">
        <span class="fuel-psst" id="fuelPsst" aria-hidden="true">PSSHT!</span>
      </figure>
      <div class="stamp-spin stamp-fuel" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs><path id="stampPath2" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
          <circle cx="60" cy="60" r="58" class="stamp-ring"/>
          <text class="stamp-text"><textPath href="#stampPath2">FOCUS · PLAY · REPEAT · NATURAL ENERGY · </textPath></text>
          <g transform="translate(38,39) scale(5.5)"><use href="#bunny" width="8.2" height="7.2" color="#ffd400" style="--bunny-eye:#050508"></use></g>
        </svg>
      </div>
    </div>

    <div class="fuel-copy">
      <p class="sec-kicker rv" data-i18n="fuel.kicker">Nº 02 — EL PRODUCTO HÉROE</p>
      <h2 class="sec-title rv" data-delay="80" data-i18n-html="fuel.title">ENERGÍA<br><em>SIN CUENTOS.</em></h2>
      <p class="fuel-tagline rv" data-delay="120">FOCUS · PLAY · REPEAT —</p>
      <p class="fuel-lead rv" data-delay="160" data-i18n="fuel.lead">Yerba mate + guaraná. Cero taurina, cero cosas raras.</p>

      <ul class="fuel-ings">
        <li class="rv" data-delay="200">
          <span class="ing-ico" aria-hidden="true">☘</span>
          <div><strong>YERBA MATE</strong><p data-i18n="fuel.ing1">Energía natural, sin el bajón de después.</p></div>
        </li>
        <li class="rv" data-delay="260">
          <span class="ing-ico" aria-hidden="true">◉</span>
          <div><strong>GUARANÁ</strong><p data-i18n="fuel.ing2">Enfoque y vitalidad que duran.</p></div>
        </li>
        <li class="rv" data-delay="320">
          <span class="ing-ico" aria-hidden="true">✚</span>
          <div><strong data-i18n="fuel.ing3name">VITAMINAS B</strong><p data-i18n="fuel.ing3">Rendimiento sostenido.</p></div>
        </li>
        <li class="rv" data-delay="380">
          <span class="ing-ico" aria-hidden="true">ϟ</span>
          <div><strong data-i18n="fuel.ing4name">ELECTROLITOS</strong><p data-i18n="fuel.ing4">Hidratación mientras juegas.</p></div>
        </li>
      </ul>

      <div class="fuel-nutri rv" data-delay="420">
        <div class="fuel-nutri-table">
          <p class="fn-title" data-i18n="fuel.nutriTitle">INFORMACIÓN NUTRICIONAL</p>
          <p class="fn-sub" data-i18n="fuel.nutriSub">(por porción 250 ml)</p>
          <dl>
            <div><dt data-i18n="fuel.nEnergy">Energía</dt><dd>90 kcal</dd></div>
            <div><dt data-i18n="fuel.nCarbs">Carbohidratos</dt><dd>22 g</dd></div>
            <div><dt data-i18n="fuel.nSugar">Azúcares</dt><dd>0 g</dd></div>
            <div><dt data-i18n="fuel.nSodium">Sodio</dt><dd>40 mg</dd></div>
            <div><dt data-i18n="fuel.nTaurine">Taurina</dt><dd>0 mg</dd></div>
          </dl>
        </div>
        <div class="fuel-kcal">
          <span class="fk-num">90</span>
          <span class="fk-label" data-i18n="fuel.kcalLabel">KCAL POR PORCIÓN</span>
        </div>
      </div>

      <div class="fuel-chips rv" data-delay="460">
        <span>250 ML</span><span data-i18n="fuel.chipVegan">VEGANA</span><span data-i18n="fuel.chipTaurine">SIN TAURINA</span><span data-i18n="fuel.chipSugar">SIN AZÚCAR</span>
      </div>

      <div class="hero-ctas rv" data-delay="520">
        <button class="btn btn-pink" id="btnFuelAdd" type="button" data-i18n="fuel.cta">PROBAR PACK ×4 — $16</button>
      </div>
    </div>
  </div>
</section>
