<!-- ============ RABBIT FUEL ============ -->
<section class="fuel" id="fuel">
  <div class="fuel-inner">
    <div class="fuel-visual rv">
      <figure class="fuel-can-wrap" id="fuelCan" title="PSSHT!">
        <img src="/assets/can-cutout.png" alt="Rabbit Fuel 250 ml — Natural Energy, mate + guaraná">
        <span class="fuel-psst" id="fuelPsst" aria-hidden="true">PSSHT!</span>
      </figure>
      <div class="stamp-spin stamp-fuel" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs><path id="stampPath2" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
          <circle cx="60" cy="60" r="58" class="stamp-ring"/>
          <text class="stamp-text"><textPath href="#stampPath2">FOCUS · PLAY · REPEAT · NATURAL ENERGY · </textPath></text>
          <g transform="translate(38,39) scale(5.5)"><use href="#bunny" width="8.2" height="7.2" color="#ffd400" style="--bunny-eye:#050508"></use></g>
        </svg>
      </div>
    </div>

    <div class="fuel-copy">
      <p class="sec-kicker rv" data-i18n="fuel.kicker">No. 01 — THE HERO PRODUCT</p>
      <h2 class="sec-title rv" data-delay="80" data-i18n-html="fuel.title">ENERGY,<br><em>NO NONSENSE.</em></h2>
      <p class="fuel-tagline rv" data-delay="120">FOCUS · PLAY · REPEAT —</p>
      <p class="fuel-lead rv" data-delay="160" data-i18n="fuel.lead">Yerba mate + guaraná. Zero taurine, zero weird stuff.</p>

      <ul class="fuel-ings">
        <li class="rv" data-delay="200">
          <span class="ing-ico" aria-hidden="true">☘</span>
          <div><strong>YERBA MATE</strong><p data-i18n="fuel.ing1">Natural energy without the crash.</p></div>
        </li>
        <li class="rv" data-delay="260">
          <span class="ing-ico" aria-hidden="true">◉</span>
          <div><strong>GUARANÁ</strong><p data-i18n="fuel.ing2">Focus and vitality that last.</p></div>
        </li>
        <li class="rv" data-delay="320">
          <span class="ing-ico" aria-hidden="true">✚</span>
          <div><strong data-i18n="fuel.ing3name">B VITAMINS</strong><p data-i18n="fuel.ing3">Sustained performance.</p></div>
        </li>
        <li class="rv" data-delay="380">
          <span class="ing-ico" aria-hidden="true">ϟ</span>
          <div><strong data-i18n="fuel.ing4name">ELECTROLYTES</strong><p data-i18n="fuel.ing4">Hydration while you play.</p></div>
        </li>
      </ul>

      <div class="fuel-nutri rv" data-delay="420">
        <div class="fuel-nutri-table">
          <p class="fn-title" data-i18n="fuel.nutriTitle">NUTRITION FACTS</p>
          <p class="fn-sub" data-i18n="fuel.nutriSub">(per 250 ml serving)</p>
          <dl>
            <div><dt data-i18n="fuel.nEnergy">Energy</dt><dd>90 kcal</dd></div>
            <div><dt data-i18n="fuel.nCarbs">Carbohydrates</dt><dd>22 g</dd></div>
            <div><dt data-i18n="fuel.nSugar">Sugars</dt><dd>0 g</dd></div>
            <div><dt data-i18n="fuel.nSodium">Sodium</dt><dd>40 mg</dd></div>
            <div><dt data-i18n="fuel.nTaurine">Taurine</dt><dd>0 mg</dd></div>
          </dl>
        </div>
        <div class="fuel-kcal">
          <span class="fk-num">90</span>
          <span class="fk-label" data-i18n="fuel.kcalLabel">KCAL PER SERVING</span>
        </div>
      </div>

      <div class="fuel-chips rv" data-delay="460">
        <span>250 ML</span><span data-i18n="fuel.chipVegan">VEGAN</span><span data-i18n="fuel.chipTaurine">ZERO TAURINE</span><span data-i18n="fuel.chipSugar">ZERO SUGAR</span>
      </div>

      <div class="hero-ctas rv" data-delay="520">
        <button class="btn btn-pink" id="btnFuelAdd" type="button" data-i18n="fuel.cta">TRY THE 4-PACK — $16</button>
      </div>
    </div>
  </div>
</section>
