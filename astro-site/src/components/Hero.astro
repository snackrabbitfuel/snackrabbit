        <span class="hero-hopper" aria-hidden="true"><span class="hh-x"><span class="hh-y"><svg><use href="#bunny"></use></svg></span></span></span>
        <span class="ht-line"><span class="ht-word" id="htWord1"></span></span>
        <span class="ht-line ht-line-hl"><span class="ht-word" id="htWord2"></span></span>
