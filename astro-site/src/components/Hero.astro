        <a class="btn btn-ink" href="#drop" data-i18n="hero.cta1">SHOP THE DROP ▸</a>
        <a class="btn btn-ghost" href="#fuel" data-i18n="hero.cta2">SEE RABBIT FUEL</a>
      </div>
      <p class="hero-meta rv" data-delay="740" data-i18n="hero.meta">ZERO SUGAR · ZERO TAURINE · MATE + GUARANÁ · 48H SHIPPING</p>
    </div>

    <div class="hero-visual" id="heroVisual">
      <div class="hero-tape" aria-hidden="true">
        <div class="hero-tape-track">
          <span data-i18n="hero.tape">100% REAL ▸ NO WEIRD STUFF ▸ ZERO SUGAR ▸ 100% REAL ▸ NO WEIRD STUFF ▸ ZERO SUGAR ▸ </span>
          <span data-i18n="hero.tape">100% REAL ▸ NO WEIRD STUFF ▸ ZERO SUGAR ▸ 100% REAL ▸ NO WEIRD STUFF ▸ ZERO SUGAR ▸ </span>
        </div>
      </div>
      <!-- El lema de la sesión de fotos, en texto de verdad: nítido a cualquier
           tamaño. Va en aria-hidden porque la propia lata ya lo dice. -->
      <p class="hv-lema" aria-hidden="true">FOCUS<br><em>PLAY</em><br>REPEAT</p>
      <!-- Sin peluche: la lata es el producto héroe, de pie sobre la roca del
           fondo. El sello que gira y la banda amarilla siguen igual. -->
      <figure class="hv-obj hv-can" data-depth="26" id="heroCan" title="Click!">
        <!-- Recorte de la toma con humo, no el plano de catálogo: en el hero
             manda la atmósfera. El de catálogo sigue en can-cutout.webp, que lo
             usan la sección de Rabbit Fuel y la galería del producto. -->
        <img src="/assets/can-hero.webp" alt="Rabbit Fuel — Natural Energy 250 ml" width="213" height="531" loading="eager">
      </figure>

      <div class="stamp-spin" data-depth="40" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <defs><path id="stampPath" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs>
          <circle cx="60" cy="60" r="58" class="stamp-ring stamp-fill"/>
          <circle cx="60" cy="60" r="34" class="stamp-ring stamp-ring-in"/>
          <text class="stamp-text"><textPath href="#stampPath" data-i18n="hero.stamp">100% REAL · NO WEIRD STUFF · 100% REAL · </textPath></text>
          <g transform="translate(38,39) scale(5.5)"><use href="#bunny" width="8.2" height="7.2" color="#ffd400" style="--bunny-eye:#050508"></use></g>
        </svg>
      </div>
      <span class="hero-badge" data-depth="34" aria-hidden="true" data-i18n-html="hero.badge">ZERO<br>SUGAR</span>
    </div>
  </div>

  <a class="hero-scroll" href="#stats" aria-label="Scroll">▼</a>
