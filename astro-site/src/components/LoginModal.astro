---
/* Login y registro reales con Clerk (custom flows): la autenticación la hace
   Clerk, pero toda la interfaz es nuestra — este marcado no lo genera Clerk.
   La lógica vive en el módulo Auth de app.js. */
---

<!-- ============ LOGIN MODAL ============ -->
<div class="modal login-modal" id="loginModal" role="dialog" aria-modal="true" aria-labelledby="loginTitle" hidden>
  <button class="modal-x" data-close data-i18n-aria="aria.close" aria-label="Close">✕</button>
  <svg class="lm-bunny" aria-hidden="true"><use href="#bunny"></use></svg>
  <h2 id="loginTitle" class="lm-title" data-i18n="auth.title">THE BURROW</h2>
  <!-- Sin role="tablist": eran pestañas a medias —había role="tab" pero ningún
       role="tabpanel" ni aria-controls— y un patrón ARIA incompleto confunde más
       que no ponerlo. Son dos botones que cambian de formulario, y como tales se
       anuncian. aria-pressed dice cuál está activo. -->
  <div class="lm-tabs">
    <button class="lm-tab active" id="tabIn" type="button" aria-pressed="true" data-i18n="auth.tabIn">SIGN IN</button>
    <button class="lm-tab" id="tabUp" type="button" aria-pressed="false" data-i18n="auth.tabUp">SIGN UP</button>
  </div>

  <form class="lm-form" id="formIn" novalidate>
    <label><span data-i18n="auth.email">EMAIL</span><input type="email" name="email" placeholder="you@email.com" data-i18n-ph="auth.emailPh" autocomplete="email" required></label>
    <label><span data-i18n="auth.pass">PASSWORD</span><input type="password" name="pass" placeholder="••••••" autocomplete="current-password" required></label>
    <button class="lm-link" id="lmOlvide" type="button" data-i18n="auth.forgot">FORGOT YOUR PASSWORD?</button>
    <p class="lm-err" role="alert"></p>
    <button class="btn btn-pink lm-submit" type="submit" data-i18n="auth.submitIn">SIGN IN ▸</button>
  </form>

  <form class="lm-form" id="formUp" hidden novalidate>
    <label><span data-i18n="auth.name">NAME</span><input type="text" name="name" placeholder="Your name" data-i18n-ph="auth.namePh" autocomplete="name" required></label>
    <label><span data-i18n="auth.email">EMAIL</span><input type="email" name="email" placeholder="you@email.com" data-i18n-ph="auth.emailPh" autocomplete="email" required></label>
    <label><span data-i18n="auth.pass">PASSWORD</span><input type="password" name="pass" placeholder="At least 8 characters" data-i18n-ph="auth.passPh" autocomplete="new-password" required></label>
    <p class="lm-err" role="alert"></p>
    <!-- Clerk monta aquí su verificación anti-bots. Sin este elemento usa un
         CAPTCHA invisible que puede bloquear a usuarios legítimos sin avisar. -->
    <div id="clerk-captcha"></div>
    <button class="btn btn-pink lm-submit" type="submit" data-i18n="auth.submitUp">CREATE ACCOUNT ▸</button>
    <p class="lm-legal" data-i18n-html="auth.legal">Creating an account means you accept our <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>.</p>
  </form>

  <form class="lm-form" id="formCode" hidden novalidate>
    <!-- Sin data-i18n: el texto lleva el correo dentro y va con <strong>, así que
         al cambiar de idioma applyLang lo habría escrito como texto plano y se
         veía el "{email}" y las etiquetas en crudo. Lo escribe el JS. -->
    <p class="lm-sent" id="lmSent">We sent a 6-digit code to your email.</p>
    <label class="lm-code-label">
      <span data-i18n="auth.code">VERIFICATION CODE</span>
      <input class="lm-code" type="text" name="code" inputmode="numeric" pattern="[0-9]*"
             autocomplete="one-time-code" maxlength="6" placeholder="000000" required>
    </label>
    <p class="lm-err" role="alert"></p>
    <button class="btn btn-pink lm-submit" type="submit" data-i18n="auth.submitCode">VERIFY ▸</button>
    <button class="lm-resend" id="lmResend" type="button" data-i18n="auth.resend">RESEND CODE</button>
    <!-- Sin esta vuelta, el paso del código era un callejón: quien cerraba el
         modal o se equivocaba de correo no tenía forma de volver al principio. -->
    <button class="lm-link" data-volver type="button" data-i18n="auth.backIn">← BACK TO SIGN IN</button>
  </form>

  <!-- ---- Recuperar contraseña: pedir el código ---- -->
  <form class="lm-form" id="formLost" hidden novalidate>
    <p class="lm-sent" data-i18n="auth.lostIntro">Enter your email and we will send you a code to set a new password.</p>
    <label><span data-i18n="auth.email">EMAIL</span><input type="email" name="email" placeholder="you@email.com" data-i18n-ph="auth.emailPh" autocomplete="email" required></label>
    <p class="lm-err" role="alert"></p>
    <button class="btn btn-pink lm-submit" type="submit" data-i18n="auth.submitLost">SEND ME A CODE ▸</button>
    <button class="lm-link" data-volver type="button" data-i18n="auth.backIn">← BACK TO SIGN IN</button>
  </form>

  <!-- ---- Recuperar contraseña: código + contraseña nueva ---- -->
  <form class="lm-form" id="formReset" hidden novalidate>
    <p class="lm-sent" id="lmSentReset">We sent a 6-digit code to your email.</p>
    <label class="lm-code-label">
      <span data-i18n="auth.code">VERIFICATION CODE</span>
      <input class="lm-code" type="text" name="code" inputmode="numeric" pattern="[0-9]*"
             autocomplete="one-time-code" maxlength="6" placeholder="000000" required>
    </label>
    <label><span data-i18n="auth.newPass">NEW PASSWORD</span><input type="password" name="pass" data-i18n-ph="auth.passPh" placeholder="At least 8 characters" autocomplete="new-password" required></label>
    <p class="lm-err" role="alert"></p>
    <button class="btn btn-pink lm-submit" type="submit" data-i18n="auth.submitReset">SET NEW PASSWORD ▸</button>
    <button class="lm-link" data-volver type="button" data-i18n="auth.backIn">← BACK TO SIGN IN</button>
  </form>

  <p class="lm-note" data-i18n="auth.note">SECURE SIGN-IN · WE NEVER SEE YOUR PASSWORD.</p>
</div>
