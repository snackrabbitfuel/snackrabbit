---
import "../styles/styles.css";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  lang?: string;
}

/* El sitio se sirve en inglés; el español es opt-in con el selector ES/EN y
   app.js lo reescribe en cliente, recordando la elección en localStorage. */
const {
  title = "SNACKRABBIT — DROP 001 · Merch for curious people",
  description = "SnackRabbit DROP 001: Rabbit Fuel, the natural energy drink in five flavors, and The Lookout plush. Zero taurine, zero weird stuff.",
  ogTitle = "SNACKRABBIT — DROP 001",
  ogDescription = "Follow the rabbit. Curiosity got you this far; the burrow does the rest. Limited edition: nothing comes back.",
  ogImage = "/assets/product-rabbit-fuel.jpg",
  lang = "en",
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0a0a12">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
{/* La imagen de las vistas previas tiene que ir con URL absoluta. WhatsApp,
    X y Facebook no resuelven rutas relativas: leen el HTML desde su propio
    servidor, sin saber de dónde salió. Con "/assets/..." el enlace se
    compartía sin imagen — comprobado en producción. */}
<meta property="og:image" content={new URL(ogImage, Astro.site).href}>
<meta property="og:url" content={Astro.url.href}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="SNACKRABBIT">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content={new URL(ogImage, Astro.site).href}>
<link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 9"><rect width="10" height="9" fill="%23ff4fd8"/><g fill="%23050508"><rect x="3" y="1" width="1" height="3"/><rect x="8" y="1" width="1" height="3"/><rect x="3" y="4" width="6" height="1"/><rect x="2" y="5" width="8" height="2"/><rect x="3" y="7" width="6" height="1"/></g><rect x="4" y="5" width="1" height="1" fill="%23ff4fd8"/><rect x="7" y="5" width="1" height="1" fill="%23ff4fd8"/><rect x="5" y="6" width="2" height="1" fill="%23ff4fd8"/></svg>'>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Serif+Display:ital@1&family=Bricolage+Grotesque:opsz,wght@12..96,600..700&display=swap" rel="stylesheet">
</head>
<body>
<!-- Primer elemento tabulable de la página: quien navega con teclado no tiene
     que recorrerse el menú entero en cada pantalla para llegar al contenido.
     Solo se ve al recibir el foco. -->
<a class="skip" href="#top" data-i18n="a11y.skip">Skip to content</a>
<!-- Sin JavaScript la tienda no funciona: el carrito, el catálogo y las cuentas
     viven en app.js. Antes no se decía nada y quedaba una página rosa sin
     explicación; ahora al menos se sabe qué pasa y adónde escribir. -->
<noscript>
  <!-- El telón de carga se despega con JavaScript; sin él tapaba este mismo
       aviso para siempre. El navegador solo aplica este estilo exactamente
       cuando hace falta. -->
  <style>.preloader { display: none; }</style>
  <div class="sinjs">
    <p><strong>This site needs JavaScript to shop.</strong></p>
    <p>The catalogue, the cart and your account all run in the browser. Turn it on, or write to
      <a href="mailto:hello@snackrabbit.co">hello@snackrabbit.co</a> and we take your order by email.</p>
    <p><a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> · <a href="/returns">Returns</a> · <a href="/shipping">Shipping</a></p>
  </div>
</noscript>
<slot />
<script>
  import "../scripts/app.js";
</script>
</body>
</html>
