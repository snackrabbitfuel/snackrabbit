---
import "../styles/styles.css";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  lang?: string;
}

/* El sitio se sirve en inglés; el español es opt-in con el selector ES/EN y
   app.js lo reescribe en cliente, recordando la elección en localStorage. */
const {
  title = "SNACKRABBIT — DROP 001 · Merch for curious people",
  description = "SnackRabbit DROP 001: Rabbit Fuel, the natural energy drink, the Gym Towel and the official plush. Zero taurine, zero weird stuff.",
  ogTitle = "SNACKRABBIT — DROP 001",
  ogDescription = "Follow the rabbit. Curiosity got you this far; the burrow does the rest. Limited edition: nothing comes back.",
  ogImage = "/assets/product-rabbit-fuel.jpg",
  lang = "en",
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0a0a12">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content={ogImage}>
<link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 9"><rect width="10" height="9" fill="%23ff4fd8"/><g fill="%23050508"><rect x="3" y="1" width="1" height="3"/><rect x="8" y="1" width="1" height="3"/><rect x="3" y="4" width="6" height="1"/><rect x="2" y="5" width="8" height="2"/><rect x="3" y="7" width="6" height="1"/></g><rect x="4" y="5" width="1" height="1" fill="%23ff4fd8"/><rect x="7" y="5" width="1" height="1" fill="%23ff4fd8"/><rect x="5" y="6" width="2" height="1" fill="%23ff4fd8"/></svg>'>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Serif+Display:ital@1&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
<slot />
<script>
  import "../scripts/app.js";
</script>
</body>
</html>
