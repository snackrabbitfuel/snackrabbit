---
/* Ficha de producto: app.js (ProductModal) la rellena con el producto elegido —
   galería de vistas, características, talla, color y cantidad. */
---

<!-- ============ PRODUCT MODAL ============ -->
<div class="modal product-modal" id="productModal" role="dialog" aria-modal="true" aria-labelledby="pmName" hidden>
  <button class="modal-x" data-close data-i18n-aria="aria.close" aria-label="Cerrar">✕</button>
  <div class="pm-media">
    <img id="pmImg" src="" alt="">
    <div class="pm-thumbs" id="pmThumbs"></div>
  </div>
  <div class="pm-info">
    <p class="pm-num" id="pmNum"></p>
    <h2 class="pm-name" id="pmName"></h2>
    <p class="pm-tagline" id="pmTagline"></p>
    <p class="pm-desc" id="pmDesc"></p>
    <p class="pm-specs" id="pmSpecs"></p>
    <ul class="pm-features" id="pmFeatures"></ul>

    <div class="pm-row" id="pmColorsRow">
      <span class="pm-label">COLOR</span>
      <div class="pm-swatches" id="pmSwatches"></div>
    </div>
    <div class="pm-row" id="pmSizesRow">
      <span class="pm-label" id="pmSizeLabel">TALLA</span>
      <div class="pm-sizes" id="pmSizes"></div>
    </div>
    <div class="pm-row">
      <span class="pm-label" data-i18n="pm.qty">CANTIDAD</span>
      <div class="pm-qty">
        <button type="button" id="pmMinus" aria-label="−">−</button>
        <span id="pmQty">1</span>
        <button type="button" id="pmPlus" aria-label="+">+</button>
      </div>
    </div>

    <div class="pm-foot">
      <span class="pm-price" id="pmPrice"></span>
      <button class="btn btn-pink" id="pmAdd" type="button" data-i18n="pm.add">AÑADIR AL CARRITO ▸</button>
    </div>
    <p class="pm-ship" data-i18n="pm.ship">ENVÍO 48H · DEVOLUCIONES 30 DÍAS · PAGO SEGURO</p>
  </div>
</div>
