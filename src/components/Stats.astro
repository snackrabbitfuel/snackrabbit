---
/* El contador de productos lo rellena app.js con PRODUCTS.length: añadir un
   producto actualiza este número solo. */
---

<!-- ============ STATS ============ -->
<section class="stats" id="stats">
  <div class="stat rv"><span class="stat-num" data-count="2.4" data-decimals="1" data-suffix="M">0</span><span class="stat-label" data-i18n="stats.followers">SEGUIDORES</span></div>
  <div class="stat rv" data-delay="90"><span class="stat-num" data-count="180" data-suffix="M">0</span><span class="stat-label" data-i18n="stats.views">VIEWS TOTALES</span></div>
  <div class="stat rv" data-delay="180" id="statProducts"><span class="stat-num" data-count="5" data-pad="2">0</span><span class="stat-label" data-i18n="stats.products">PRODUCTOS</span></div>
  <div class="stat rv" data-delay="270"><span class="stat-num" data-count="48" data-suffix="H">0</span><span class="stat-label" data-i18n="stats.shipping">ENVÍO EXPRESS</span></div>
</section>
