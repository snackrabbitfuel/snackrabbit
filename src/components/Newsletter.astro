<!-- ============ NEWSLETTER ============ -->
<section class="news" id="newsletter">
  <div class="news-inner rv">
    <svg class="news-bunny" aria-hidden="true"><use href="#bunny"></use></svg>
    <h2 class="news-title" data-i18n-html="news.title">ÚNETE A<br>LA MADRIGUERA</h2>
    <p class="news-sub" data-i18n="news.sub">Un email al mes: drops, curiosidades y cero spam.</p>
    <form class="news-form" id="newsForm" novalidate>
      <input type="email" id="newsEmail" name="email" placeholder="TU@EMAIL.COM" data-i18n-ph="news.ph" aria-label="Email" required>
      <button class="btn btn-ink" type="submit" data-i18n="news.btn">SUSCRIBIRME ▸</button>
    </form>
    <p class="news-msg" id="newsMsg" role="status"></p>
  </div>
</section>
